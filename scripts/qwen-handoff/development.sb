(version 1)
(import (param "BASE_PROFILE"))

;; This is the Qwen client, not a generated-code executor. Only its
;; read/edit tools are exposed; candidate code still runs offline after review.
(allow network*)
(allow mach-lookup
    (global-name "com.apple.mDNSResponder")
    (global-name "com.apple.SystemConfiguration.configd"))
