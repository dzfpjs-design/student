{
  "name": "synthetic-nsis-template-test",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated synthetic electron-builder NSIS experiment",
  "main": "main.js",
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "test.synthetic.placeholder",
    "files": ["main.js", "package.json"],
    "win": {"target": "nsis", "signAndEditExecutable": false},
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
